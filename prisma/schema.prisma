generator client {
  provider      = "prisma-client-js"
  // Native bundles support older Debian/Ubuntu OpenSSL 1.1 hosts and current
  // OpenSSL 3 hosts regardless of which runner builds the release artifact.
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------

enum Role {
  ADMIN
  USER
}

enum Source {
  MANUAL
  PROXMOX
  OPNSENSE
  UNIFI
  CLOUDFLARE
  TAILSCALE
  EDGE_NAT_SERVER
}

enum EntityStatus {
  ACTIVE
  STALE
  REMOVED
}

enum PowerState {
  RUNNING
  STOPPED
  PAUSED
  UNKNOWN
}

enum SyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum IntegrationType {
  PROXMOX
  OPNSENSE
  ELASTICSEARCH
  UNIFI
  OTX
  CLOUDFLARE
  TAILSCALE
  EDGE_NAT_SERVER
  CENSYS
  SECURITYTRAILS
}

enum FirewallAction {
  PASS
  BLOCK
  REJECT
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum TicketSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

// ---------- auth / accounts ----------

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  displayName     String?
  passwordHash    String
  role            Role     @default(USER)
  disabled        Boolean  @default(false)
  themeColor      String   @default("blue")
  themeMode       String   @default("system")
  anonymousMode   Boolean  @default(false)
  shieldOnCapture Boolean  @default(false)
  shieldOnBlur    Boolean  @default(false)
  /**
   * Personal AlienVault OTX API key (encrypted); overrides the instance feed for this user.
   */
  encryptedOtxKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions      Session[]
  apiTokens     ApiToken[]
  auditLogs     AuditLog[]
  docPages      DocPage[]              @relation("DocAuthor")
  closedTickets SecurityTicket[]       @relation("TicketCloser")
  researchPages SecurityResearchPage[] @relation("ResearchPageCreator")
  workflows     Workflow[]             @relation("WorkflowCreator")
  otxPulseReads OtxPulseRead[]
}

model Session {
  id        String   @id // sha256(sessionToken); raw token only lives in the cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([userId])
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique // sha256 of "ps_<random>"
  tokenPrefix String // first chars for display
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes      String[]  @default(["read"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------- integrations ----------

model IntegrationConfig {
  id                   String          @id @default(cuid())
  type                 IntegrationType
  name                 String
  enabled              Boolean         @default(true)
  baseUrl              String
  encryptedCredentials String
  verifyTls            Boolean         @default(true)
  syncIntervalMinutes  Int             @default(15)
  settings             Json? // integration-specific extras (e.g. Elasticsearch index pattern)
  lastSyncAt           DateTime?
  lastSyncStatus       SyncStatus?
  lastSyncError        String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  syncRuns                  SyncRun[]
  devices                   Device[]
  virtualMachines           VirtualMachine[]
  containers                Container[]
  networks                  Network[]
  networkInterfaces         NetworkInterface[]
  storagePools              StoragePool[]
  firewallRules             FirewallRule[]
  firewallAliases           FirewallAlias[]
  dhcpLeases                DhcpLease[]
  networkNeighbors          NetworkNeighbor[]
  wirelessNetworks          WirelessNetwork[]
  wirelessAps               WirelessAp[]
  portForwards              PortForward[]
  dyndnsHosts               DyndnsHost[]
  networkGateways           NetworkGateway[]
  trafficSamples            TrafficCounterSample[]
  edgeNatRules              EdgeNatRule[]
  connectorLinks            ConnectorEdgeLink[]
  services                  Service[]
  censysLookupCache         CensysLookupCache[]
  censysApiUsage            CensysApiUsage[]
  securityTrailsLookupCache SecurityTrailsLookupCache[]
  securityTrailsApiUsage    SecurityTrailsApiUsage[]

  @@unique([type, name])
}

/// A reverse-tunnel connector, modelled on Cloudflare Tunnel connectors.
///
/// A connector is a STANDALONE machine, not the property of any one edge server.
/// It is installed once, generates its own WireGuard keypair (the private half
/// NEVER leaves the host), and dials OUT to every edge server it is linked to.
/// One installed connector can therefore serve many edge boxes, and any edge box
/// can route through any linked connector — the link (and the per-edge tunnel
/// address allocated from that edge's own subnet) lives on ConnectorEdgeLink.
model Connector {
  id                   String    @id @default(cuid())
  /// Unique across the instance: connectors are no longer scoped to one edge.
  name                 String    @unique
  /// What kind of peer this connector is. Every kind is a WireGuard peer of the
  /// edge and gets an allocated tunnel address; they differ only in how the far
  /// side is set up and whether PolySIEM manages it.
  ///   "agent"    — PolySIEM's connector agent is installed on a Linux host and
  ///                managed over SSH/token; it performs the last hop itself.
  ///   "opnsense" — an OPNsense box configured by the operator; PolySIEM shows a
  ///                paste-ready peer block and only needs its public key back.
  ///   "peer"     — any other WireGuard endpoint, same manual flow as OPNsense.
  /// Non-agent kinds never receive an install token, SSH key, or pushed rules.
  kind                 String    @default("agent")
  /// Stable public identifier surfaced in the UI and used by the agent to
  /// identify itself. Opaque, URL-safe, generated once (never reused).
  connectorId          String    @unique
  /// WireGuard interface the agent owns on the host. One interface carries a peer
  /// per linked edge, so a single connector serves many edges without extra netdevs.
  interfaceName        String    @default("wg0")
  /// The connector's WireGuard public key — ONE identity reused across every edge
  /// it links to. Reported by the agent (or pasted for manual kinds). Null until known.
  publicKey            String?
  /// sha256 of the one-time install token. The plaintext token is shown once at
  /// creation and never persisted.
  installTokenHash     String?
  installTokenIssuedAt DateTime?
  enrolledAt           DateTime?
  /// pending | connected | stale | disabled
  status               String    @default("pending")
  lastSeenAt           DateTime?
  lastHandshakeAt      DateTime?
  osInfo               String?
  agentVersion         String?
  notes                String?
  metadata             Json?

  /// SSH management, mirroring the Edge NAT server's restricted forced-command
  /// model so PolySIEM manages BOTH ends of the tunnel the same way. The private
  /// half lives only in `encryptedCredentials` (AES-GCM under APP_SECRET); the
  /// agent is reachable only as `sshUsername` and only runs the connector agent.
  sshHost               String?
  sshPort               Int       @default(22)
  sshUsername           String    @default("polysiem-connector")
  /// PolySIEM-generated public key the operator installs on the connector.
  sshPublicKey          String?
  /// The exact `restrict,command="…"` authorized_keys line for that public key.
  sshAuthorizedKey      String?
  sshHostKeyFingerprint String?
  sshProvisionedAt      DateTime?
  encryptedCredentials  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules EdgeNatRule[]
  links ConnectorEdgeLink[]

  @@index([status])
  @@index([kind])
}

/// One connector peered with one Edge NAT server.
///
/// This is what makes connectors and edge boxes independent: a connector may be
/// linked to many edges and an edge may accept many connectors. Each link carries
/// the tunnel address allocated from THAT edge's own subnet (a connector therefore
/// holds a different tunnel IP on each edge it serves), which is why the address
/// cannot live on Connector.
model ConnectorEdgeLink {
  id              String            @id @default(cuid())
  connectorId     String
  connector       Connector         @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  integrationId   String
  integration     IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  /// Implicitly allocated host address inside this edge's tunnel subnet (e.g. "10.9.9.3").
  /// Allocated by PolySIEM, never typed by the operator.
  tunnelAddress   String
  /// Set false to keep the link on record while tearing the peer off the edge.
  enabled         Boolean           @default(true)
  /// Last handshake PolySIEM observed for this connector on this edge.
  lastHandshakeAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([connectorId, integrationId])
  @@unique([integrationId, tunnelAddress])
  @@index([integrationId, enabled])
}

/// A narrowly-scoped inbound DNAT rule owned by one Edge NAT Server.
/// Rules are rendered only into PolySIEM-dedicated iptables chains.
///
/// `mode` selects how the published port reaches its target:
///   "direct"    — the edge DNATs straight to targetAddress:targetPort, which must
///                 be reachable from the edge itself (the original primitive behaviour).
///   "connector" — the edge forwards over the WireGuard tunnel to `connector`, and the
///                 connector performs the last hop to targetAddress:targetPort as seen
///                 FROM THE CONNECTOR. The connector's own tunnel IP stays implicit.
model EdgeNatRule {
  id            String            @id @default(cuid())
  integrationId String
  integration   IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  name          String
  protocol      String
  publicPort    Int
  targetAddress String
  targetPort    Int
  sourceCidr    String?
  enabled       Boolean           @default(true)
  mode          String            @default("direct")
  connectorId   String?
  connector     Connector?        @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([integrationId, protocol, publicPort])
  @@index([integrationId, enabled])
  @@index([connectorId])
}

// ---------- privacy router (managed policy-routing box) ----------

/// A Linux host PolySIEM manages over SSH, in ONE standardized shape.
///
/// The columns mirror the SSH half of `Connector` (sshHost/sshPort/sshUsername/
/// sshPublicKey/sshAuthorizedKey/sshHostKeyFingerprint/sshProvisionedAt/
/// encryptedCredentials) because that model is the one that already got the
/// restricted forced-command story right. Same custody rules apply: the private
/// half lives ONLY in `encryptedCredentials` (AES-GCM under APP_SECRET), the
/// account is reachable only as `username`, and it only runs one forced command.
///
/// SCOPE, deliberately: only `PrivacyRouter` points here today. `Connector` and the
/// EDGE_NAT_SERVER integration keep their own SSH columns until a separate,
/// separately-reviewed migration moves them — those boxes carry live production
/// traffic and rewriting their storage alongside a new feature is how you break
/// someone's house. `kind` exists so that later backfill can tell rows apart
/// without guessing.
///
/// Lifetime: a ManagedHost is owned by whatever references it. Deleting a
/// PrivacyRouter does NOT delete its host row (the FK points the other way), so the
/// router service deletes both inside one transaction.
model ManagedHost {
  id                   String    @id @default(cuid())
  /// What PolySIEM manages this host as: "privacy-router" today; "connector" and
  /// "edge" are reserved for the follow-up that migrates those onto this table.
  kind                 String    @default("privacy-router")
  /// Hostname or IP reachable from the PolySIEM server itself. These boxes
  /// normally have no public address, so this is usually a LAN/VPN address.
  host                 String
  port                 Int       @default(22)
  /// The Linux service account whose authorized_keys carries the restricted key.
  username             String
  /// PolySIEM-generated public key the operator installs on the host.
  publicKey            String?
  /// The exact `restrict,command="…"` authorized_keys line for that public key.
  authorizedKey        String?   @db.Text
  /// SHA256:… host key pinned out of band by the operator. Cleared whenever
  /// host/port change, because the pin is only meaningful for one endpoint.
  hostKeyFingerprint   String?
  provisionedAt        DateTime?
  /// AES-GCM under APP_SECRET. Holds the private key half; never returned by any API.
  encryptedCredentials String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  privacyRouter PrivacyRouter?

  @@index([kind])
  @@index([host])
}

/// A PolySIEM-managed Linux box on the LAN that decides, per flow, whether
/// traffic egresses through the normal WAN or through one of several WireGuard
/// exits. OPNsense registers it as a gateway; the decision itself is made by
/// this router's own ordered rule list (see PrivacyRoutingRule).
///
/// Never call this an "edge" and never call an exit a "connector" — those are
/// load-bearing existing domain terms for different things.
model PrivacyRouter {
  id            String      @id @default(cuid())
  name          String      @unique
  enabled       Boolean     @default(true)
  /// 1:1 — one router per managed host. See ManagedHost for the custody rules.
  managedHostId String      @unique
  managedHost   ManagedHost @relation(fields: [managedHostId], references: [id], onDelete: Cascade)

  /// The LAN the router serves and the interfaces it serves it on. The box is a
  /// one-armed router in the field: `lanInterface` and `wanInterface` are
  /// normally the SAME NIC, which is why they are stored separately rather than
  /// derived — a two-NIC box must still be expressible.
  ///
  /// ALL THREE ARE NULLABLE, and carry no default, because a router exists
  /// BEFORE its topology is known: PolySIEM discovers the interface names by
  /// asking the box (the agent's `IFACE` status lines), and it can only ask
  /// once the agent is installed — which is after the row was created. Null
  /// therefore means "not confirmed yet", a normal state with its own step in
  /// the add flow. A default of "eth0" would make an unconfirmed guess look
  /// exactly like a confirmed answer, and `applyPrivacyRouter` would then push
  /// an nftables ruleset that routes real traffic through an interface nobody
  /// verified; it refuses on null instead.
  lanCidr      String?
  lanInterface String?
  wanInterface String?

  /// The SOURCE networks whose traffic this router policy-routes — the CIDRs
  /// OPNsense's gateway rule sends here.
  ///
  /// DELIBERATELY NOT `lanCidr`, and the distinction is the whole reason this
  /// column exists. `lanCidr` is the network the router BOX SITS ON, discovered
  /// from its own interface. This is the set of networks it SERVES. For a
  /// policy-routing gateway those are routinely different: a phone on a separate
  /// VLAN is exactly the traffic the feature exists to tunnel, and it never
  /// shares the router's own subnet. Conflating the two scoped every
  /// client-facing nftables rule — the mark chain's source guard, the QUIC drop
  /// and BOTH masquerade rules — to the router's own subnet, so traffic from any
  /// other VLAN was forwarded back out unmasqueraded and the return path
  /// collapsed at OPNsense. See the migration that added this column.
  ///
  /// A LIST, because serving several VLANs is the normal case. Defaulted to
  /// `[lanCidr]` when the topology is confirmed, so a genuinely single-subnet
  /// deployment needs no extra thought — but EMPTY IS NOT "everything": the
  /// apply refuses rather than rendering a router that masquerades the internet.
  clientNetworks String[] @default([])

  /// Where the userspace SNI/Host proxy listens. Only TCP/80 and TCP/443 are
  /// ever redirected here; everything else is decided in the kernel.
  proxyHttpPort  Int     @default(3128)
  proxyHttpsPort Int     @default(3129)
  /// Drop UDP/443 so browsers fall back to TCP+TLS, where SNI is readable.
  /// QUIC's ClientHello is encrypted, so a hostname rule cannot see through it.
  blockQuic      Boolean @default(true)

  /// What happens to a flow that matches no rule: "direct" | "exit" | "block".
  /// `defaultExitId` is required when and only when this is "exit".
  defaultAction String   @default("direct")
  defaultExitId String?
  /// Restrict, not SetNull: an exit that is a router's default must be detached
  /// deliberately. Silently nulling it would leave defaultAction="exit" with no
  /// exit, and a flow assigned to a VPN must never quietly fall back to WAN.
  /// Deleting the ROUTER is unaffected — its own row is gone before the cascade
  /// reaches its exits.
  defaultExit   VpnExit? @relation("PrivacyRouterDefaultExit", fields: [defaultExitId], references: [id], onDelete: Restrict)

  /// Monotonic revision and sha256 of the canonical ruleset the agent last
  /// confirmed applying. `appliedHash` IS the ruleset identity — private key
  /// material never appears in the hashed text, only sha256 of each key.
  appliedRevision Int       @default(0)
  appliedHash     String?
  lastStatusAt    DateTime?
  /// Whether this box was PROBED to forward through several exits at once.
  /// Null = not yet probed. False = rules naming a specific exit are honoured on
  /// the inspected path only, and the UI must warn. Never assumed true.
  exitsConcurrent Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exits          VpnExit[]              @relation("PrivacyRouterExits")
  rules          PrivacyRoutingRule[]
  trafficSamples ServiceTrafficSample[]
  trafficRollups ServiceTrafficRollup[]

  @@index([enabled])
}

/// One WireGuard tunnel configured on a privacy router. An "exit" is never a peer
/// and never a connector — it is one egress path a routing rule can select.
model VpnExit {
  id       String        @id @default(cuid())
  routerId String
  router   PrivacyRouter @relation("PrivacyRouterExits", fields: [routerId], references: [id], onDelete: Cascade)
  /// Short stable token used in the canonical ruleset (`exit:<key>`) and in the
  /// agent's interface/table naming. Unique per router, lowercase.
  key      String
  name     String
  /// The netdev the agent creates, e.g. "psvpn-us1". Unique per router: two
  /// exits sharing an interface name would silently clobber each other.
  ifName   String

  addressCidr   String
  endpoint      String
  peerPublicKey String
  keepalive     Int    @default(25)
  /// 1420 for a WireGuard tunnel over a 1500-byte underlay. MSS clamping on the
  /// exit interface is the only mitigation available on a one-armed box.
  mtu           Int    @default(1420)

  /// AES-GCM under APP_SECRET. Staged to /etc/wireguard on the box (AppArmor
  /// refuses key material read from /tmp) and never logged or returned.
  encryptedPrivateKey String? @db.Text
  /// sha256 of the private key. Safe to log, and it is what the canonical
  /// ruleset carries so a key rotation still bumps the revision.
  privateKeySha256    String?

  enabled         Boolean   @default(true)
  lastHandshakeAt DateTime?
  /// Cumulative counters as last read from `wg show <if> transfer`. BigInt: a
  /// busy tunnel exceeds 2^53 bytes. Never use 0n literals — the build targets
  /// ES2017; use BigInt(0).
  lastRxBytes     BigInt?
  lastTxBytes     BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  defaultForRouters PrivacyRouter[]      @relation("PrivacyRouterDefaultExit")
  rules             PrivacyRoutingRule[]

  @@unique([routerId, key])
  @@unique([routerId, ifName])
  @@index([routerId, enabled])
}

/// One row of the ordered, first-match-wins rule list. There is exactly ONE
/// list per router; it is evaluated in the kernel (nftables) for rules with no
/// hostname, and in the userspace proxy for TCP/80+443, which evaluates the
/// FULL list because only it can see a hostname.
///
/// `seq` is dense from 1 and ordered ascending. NOTE FOR THE REORDER PATH: the
/// unique below is checked per statement, so swapping two rows with two separate
/// UPDATEs transiently violates it. Reorder by shifting the affected rows to
/// negative seq values first, or rewrite the whole block in one statement.
model PrivacyRoutingRule {
  id       String        @id @default(cuid())
  routerId String
  router   PrivacyRouter @relation(fields: [routerId], references: [id], onDelete: Cascade)
  seq      Int
  enabled  Boolean       @default(true)
  name     String

  /// "direct" | "exit" | "block". `exitId` is set when and only when "exit".
  action String
  exitId String?
  /// Cascade matches EdgeNatRule.connector: deleting an exit deletes the rules
  /// that route through it rather than leaving rules that cannot be rendered.
  /// The UI must say how many rules a deletion takes with it.
  exit   VpnExit? @relation(fields: [exitId], references: [id], onDelete: Cascade)

  /// Match conditions. Null means "no condition on this field"; the canonical
  /// ruleset renders each unset field as the literal token "-", never blank.
  srcCidr   String?
  dstCidr   String?
  /// "tcp" | "udp"; null = any protocol.
  proto     String?
  /// Single port, inclusive range "N-M", or a comma list of either.
  dportSpec String?
  /// A hostname condition, optionally with a leading "*." wildcard. A rule with
  /// a hostname can only ever match TCP/80 or TCP/443 — it is inert otherwise,
  /// and inert again when the client uses Encrypted Client Hello.
  hostname  String?
  /// Throttle in kbit/s. Inspected rules get a smooth token bucket in the proxy;
  /// kernel rules get an nftables policer, which drops rather than shapes. The
  /// UI must label the two mechanisms differently.
  rateKbps  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routerId, seq])
  @@index([routerId, enabled, seq])
  @@index([exitId])
}

/// Per-service traffic for one router, stored as INTERVAL values.
///
/// The agent reports counters that are cumulative since the proxy started; the
/// ingest differences them and stores the difference here together with the
/// number of seconds it covers, so "average over observed seconds" is always
/// answerable without re-deriving it.
///
/// This is deliberately NOT TrafficCounterSample: that model's `bytes` column is
/// contractually cumulative and its reset detector turns interval-shaped input
/// into `delta: null` silently, and overloading its `kind` would drag these
/// high-cardinality rows into the firewall dashboard's unfiltered window query.
///
/// The column is `hostname`, NOT `externalId`: `externalId` is in the demo
/// anonymizer's SKIP_KEYS, so a hostname stored under that name would leak
/// through demo mode verbatim. `hostname` is in HOST_KEYS and gets scrubbed.
///
/// INGEST CONTRACT: `sampledAt` must be the poll's own timestamp (the agent's
/// reported instant, or one timestamp computed once per poll and reused for
/// every row of that poll). The unique below is what makes a duplicated or
/// concurrent poll idempotent, and it only works if the same poll produces the
/// same instant — `new Date()` per row defeats it. Hence no @default(now()).
model ServiceTrafficSample {
  id       String        @id @default(cuid())
  routerId String
  router   PrivacyRouter @relation(fields: [routerId], references: [id], onDelete: Cascade)
  /// Registrable hostname, lowercase. The agent folds everything past its
  /// cardinality cap into the literal hostname "other", and reports the literal
  /// "-" for a flow whose hostname was never readable.
  hostname String
  /// The egress path this traffic actually took: "direct" | "block" |
  /// "exit:<key>". The proxy counts (hostname, action) PAIRS, so one STATUS can
  /// carry the same hostname twice — once out the WAN, once through a tunnel —
  /// and folding those together would destroy the one thing this feature exists
  /// to answer: how much traffic really went through the VPN.
  action   String

  sampledAt     DateTime
  /// Seconds this interval covers; 0 would make any rate undefined, so the
  /// ingest drops a zero-length window rather than storing one.
  windowSeconds Int
  bytesIn       BigInt
  bytesOut      BigInt
  flows         Int      @default(0)

  /// Idempotent ingest, keyed the way the proxy counts: one row per pair per
  /// poll. This also serves every (routerId, hostname, …) lookup, so no separate
  /// @@index is declared for that column list — a second identical btree would
  /// only add write cost on the hottest table here.
  @@unique([routerId, hostname, action, sampledAt])
  @@index([routerId, sampledAt])
}

/// Fold-forward totals per service. Maintained by upsert + { increment } INSIDE
/// the ingest transaction, so monthly figures survive the raw-sample prune by
/// construction instead of depending on a batch job beating the pruner.
///
/// `samples` and `observedSeconds` are carried so a window served from the
/// rollup can still answer "average over the time we actually observed" — a
/// period with gaps must not be averaged over its wall-clock length.
model ServiceTrafficRollup {
  id          String        @id @default(cuid())
  routerId    String
  router      PrivacyRouter @relation(fields: [routerId], references: [id], onDelete: Cascade)
  hostname    String
  /// The egress path, carried through the fold so the direct-vs-VPN split
  /// survives the raw prune exactly as the byte totals do. See
  /// ServiceTrafficSample.action.
  action      String
  /// "day" | "month". Day rows are pruned at 400 days (a year plus a month, so
  /// year-over-year comparisons keep working); month rows are kept forever —
  /// they are tiny and they are the point of this table.
  period      String
  /// Start of the period, UTC-aligned by the ingest.
  periodStart DateTime

  bytesIn         BigInt   @default(0)
  bytesOut        BigInt   @default(0)
  samples         Int      @default(0)
  observedSeconds Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([routerId, hostname, action, period, periodStart])
  @@index([routerId, period, periodStart])
}

/// Cached Censys Platform responses. Host lookups are reused for four days so
/// assistant, MCP, and workflow callers do not repeatedly spend API credits.
model CensysLookupCache {
  id                   String            @id @default(cuid())
  integrationId        String
  integration          IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  lookupKind           String            @default("host")
  cacheKey             String
  response             Json
  responseHash         String
  previousResponseHash String?
  changed              Boolean           @default(false)
  fetchedBy            String
  fetchedAt            DateTime          @default(now())
  expiresAt            DateTime
  lastAccessedAt       DateTime          @default(now())
  hitCount             Int               @default(0)

  @@unique([integrationId, lookupKind, cacheKey])
  @@index([integrationId, fetchedAt])
  @@index([expiresAt])
}

/// One row per Censys lookup attempt. Live AI/MCP rows enforce the admin's
/// rolling 24-hour budget; cache hits are recorded but do not consume it.
model CensysApiUsage {
  id            String            @id @default(cuid())
  integrationId String
  integration   IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  source        String
  operation     String
  cacheKey      String
  cacheHit      Boolean
  createdAt     DateTime          @default(now())

  @@index([integrationId, source, cacheHit, createdAt])
  @@index([createdAt])
}

/// Cached read-only SecurityTrails enrichment responses. Every operation/query
/// pair is shared for four days across callers to conserve provider quota.
model SecurityTrailsLookupCache {
  id                   String            @id @default(cuid())
  integrationId        String
  integration          IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  lookupKind           String
  cacheKey             String
  response             Json
  responseHash         String
  previousResponseHash String?
  changed              Boolean           @default(false)
  fetchedBy            String
  fetchedAt            DateTime          @default(now())
  expiresAt            DateTime
  lastAccessedAt       DateTime          @default(now())
  hitCount             Int               @default(0)

  @@unique([integrationId, lookupKind, cacheKey])
  @@index([integrationId, fetchedAt])
  @@index([expiresAt])
}

/// SecurityTrails request accounting. Cached hits are retained for visibility,
/// while only live AI/MCP misses consume the rolling 24-hour admin budget.
model SecurityTrailsApiUsage {
  id            String            @id @default(cuid())
  integrationId String
  integration   IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  source        String
  operation     String
  cacheKey      String
  cacheHit      Boolean
  createdAt     DateTime          @default(now())

  @@index([integrationId, source, cacheHit, createdAt])
  @@index([createdAt])
}

model SyncRun {
  id            String            @id @default(cuid())
  integrationId String
  integration   IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  status        SyncStatus        @default(RUNNING)
  trigger       String // "interval" | "manual" | "mcp"
  startedAt     DateTime          @default(now())
  finishedAt    DateTime?
  stats         Json?
  error         String?

  @@index([integrationId, startedAt])
}

// ---------- inventory ----------

model Device {
  id            String             @id @default(cuid())
  name          String
  kind          String             @default("server") // server|hypervisor|firewall|switch|nas|other
  source        Source             @default(MANUAL)
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  externalId    String?
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  lastSeenAt    DateTime?
  description   String?            @db.Text
  manufacturer  String?
  model         String?
  location      String?
  cpuModel      String?
  cpuCores      Int?
  memoryBytes   BigInt?
  osName        String?
  osVersion     String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  vms                   VirtualMachine[]
  containers            Container[]
  interfaces            NetworkInterface[]
  services              Service[]
  storagePools          StoragePool[]
  tags                  TagAssignment[]
  switchConfig          SwitchConfig?
  switchPortConnections SwitchPort[]       @relation("SwitchPortConnections")
  wirelessAps           WirelessAp[]       @relation("ApDevice")
  tunnels               Tunnel[]
  sshKeyDeployments     SshKeyDeployment[]

  @@unique([integrationId, externalId])
  @@index([name])
}

/// A pasted switch configuration (e.g. Cisco IOS running-config), parsed into
/// VLANs and ports. Owned by a Device of kind "switch".
model SwitchConfig {
  id        String   @id @default(cuid())
  deviceId  String   @unique
  device    Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vendor    String   @default("cisco-ios")
  hostname  String?
  rawConfig String   @db.Text
  parsedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ports SwitchPort[]
  vlans SwitchVlan[]
}

model SwitchPort {
  id                String       @id @default(cuid())
  switchConfigId    String
  switchConfig      SwitchConfig @relation(fields: [switchConfigId], references: [id], onDelete: Cascade)
  name              String // "GigabitEthernet1/0/1", "Port-channel1"
  shortName         String // "Gi1/0/1", "Po1"
  description       String?
  mode              String? // access | trunk | routed | unknown
  accessVlanId      Int?
  voiceVlanId       Int?
  nativeVlanId      Int?
  allowedVlans      String? // raw range spec, e.g. "2-5,10,260"
  channelGroup      Int? // member of Port-channel<N>
  channelMode       String? // active | passive | on | desirable | auto
  isPortChannel     Boolean      @default(false)
  isShutdown        Boolean      @default(false)
  ipAddress         String? // routed ports
  connectedDeviceId String?
  connectedDevice   Device?      @relation("SwitchPortConnections", fields: [connectedDeviceId], references: [id], onDelete: SetNull)
  sortOrder         Int          @default(0)

  @@index([switchConfigId])
}

model SwitchVlan {
  id             String       @id @default(cuid())
  switchConfigId String
  switchConfig   SwitchConfig @relation(fields: [switchConfigId], references: [id], onDelete: Cascade)
  vlanId         Int
  name           String?
  svIpAddress    String? // "interface Vlan<N>" SVI address, if any
  networkId      String?
  network        Network?     @relation(fields: [networkId], references: [id], onDelete: SetNull)

  @@unique([switchConfigId, vlanId])
}

model VirtualMachine {
  id            String             @id @default(cuid())
  name          String
  source        Source             @default(MANUAL)
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  externalId    String? // "qemu/<vmid>@<node>"
  vmid          Int?
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  powerState    PowerState         @default(UNKNOWN)
  lastSeenAt    DateTime?
  description   String?            @db.Text
  hostId        String?
  host          Device?            @relation(fields: [hostId], references: [id], onDelete: SetNull)
  cpuCores      Int?
  memoryBytes   BigInt?
  diskBytes     BigInt?
  osName        String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  interfaces        NetworkInterface[]
  containers        Container[]
  services          Service[]
  tags              TagAssignment[]
  sshKeyDeployments SshKeyDeployment[]
  tunnels           Tunnel[]

  @@unique([integrationId, externalId])
  @@index([name])
  @@index([hostId])
}

model Container {
  id            String             @id @default(cuid())
  name          String
  runtime       String             @default("lxc") // lxc|docker|podman
  source        Source             @default(MANUAL)
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  externalId    String? // "lxc/<vmid>@<node>"
  vmid          Int?
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  powerState    PowerState         @default(UNKNOWN)
  lastSeenAt    DateTime?
  description   String?            @db.Text
  hostId        String?
  host          Device?            @relation(fields: [hostId], references: [id], onDelete: SetNull)
  vmId          String?
  vm            VirtualMachine?    @relation(fields: [vmId], references: [id], onDelete: SetNull)
  cpuCores      Int?
  memoryBytes   BigInt?
  diskBytes     BigInt?
  osName        String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  interfaces        NetworkInterface[]
  services          Service[]
  tags              TagAssignment[]
  sshKeyDeployments SshKeyDeployment[]
  tunnels           Tunnel[]

  @@unique([integrationId, externalId])
  @@index([name])
  @@index([hostId])
}

model Network {
  id            String             @id @default(cuid())
  name          String
  vlanId        Int?
  cidr          String? // "10.0.20.0/24"
  gateway       String?
  domain        String?
  purpose       String?
  source        Source             @default(MANUAL)
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  externalId    String?
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  lastSeenAt    DateTime?
  description   String?            @db.Text
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  ipAddresses      IpAddress[]
  interfaces       NetworkInterface[]
  dhcpLeases       DhcpLease[]
  neighbors        NetworkNeighbor[]
  tags             TagAssignment[]
  switchVlans      SwitchVlan[]
  wirelessNetworks WirelessNetwork[]

  @@unique([integrationId, externalId])
  @@index([name])
}

model IpAddress {
  id          String            @id @default(cuid())
  address     String
  networkId   String?
  network     Network?          @relation(fields: [networkId], references: [id], onDelete: SetNull)
  interfaceId String?           @unique
  interface   NetworkInterface? @relation(fields: [interfaceId], references: [id], onDelete: Cascade)
  source      Source            @default(MANUAL)
  description String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([address, networkId])
  @@index([address])
}

model NetworkInterface {
  id            String             @id @default(cuid())
  name          String // eth0, vmbr0, igb1
  macAddress    String?
  deviceId      String?
  device        Device?            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vmId          String?
  vm            VirtualMachine?    @relation(fields: [vmId], references: [id], onDelete: Cascade)
  containerId   String?
  container     Container?         @relation(fields: [containerId], references: [id], onDelete: Cascade)
  networkId     String?
  network       Network?           @relation(fields: [networkId], references: [id], onDelete: SetNull)
  source        Source             @default(MANUAL)
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  externalId    String?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  ip IpAddress?

  @@unique([integrationId, externalId])
  @@index([deviceId])
  @@index([vmId])
  @@index([containerId])
}

model Service {
  id            String             @id @default(cuid())
  name          String
  url           String?
  port          Int?
  protocol      String? // http|https|tcp|udp
  description   String?            @db.Text
  deviceId      String?
  device        Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  vmId          String?
  vm            VirtualMachine?    @relation(fields: [vmId], references: [id], onDelete: SetNull)
  containerId   String?
  container     Container?         @relation(fields: [containerId], references: [id], onDelete: SetNull)
  source        Source             @default(MANUAL)
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  externalId    String?
  metadata      Json?
  status        EntityStatus       @default(ACTIVE)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tags TagAssignment[]

  @@unique([integrationId, externalId])
  @@index([name])
}

model StoragePool {
  id            String             @id @default(cuid())
  name          String
  type          String? // zfs, lvm, dir, nfs, cifs
  deviceId      String?
  device        Device?            @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  totalBytes    BigInt?
  usedBytes     BigInt?
  source        Source             @default(MANUAL)
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  externalId    String? // "<storage>@<node>"
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  lastSeenAt    DateTime?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([integrationId, externalId])
}

// ---------- firewall ----------

model FirewallRule {
  id              String             @id @default(cuid())
  integrationId   String?
  integration     IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId      String? // rule uuid
  sequence        Int?
  action          FirewallAction     @default(PASS)
  interfaceName   String?
  direction       String?
  protocol        String?
  sourceSpec      String?
  destSpec        String?
  destPort        String?
  descriptionText String?
  enabled         Boolean            @default(true)
  source          Source             @default(OPNSENSE)
  status          EntityStatus       @default(ACTIVE)
  missCount       Int                @default(0)
  lastSeenAt      DateTime?
  annotation      String?            @db.Text // PolySIEM-owned operator note; survives sync
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([integrationId, externalId])
  @@index([interfaceName])
}

model FirewallAlias {
  id              String             @id @default(cuid())
  name            String
  aliasType       String?
  content         String[]           @default([])
  descriptionText String?
  integrationId   String?
  integration     IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId      String?
  status          EntityStatus       @default(ACTIVE)
  missCount       Int                @default(0)
  lastSeenAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([integrationId, externalId])
}

model DhcpLease {
  id            String             @id @default(cuid())
  ipAddress     String
  macAddress    String?
  hostname      String?
  isStatic      Boolean            @default(false)
  networkId     String?
  network       Network?           @relation(fields: [networkId], references: [id], onDelete: SetNull)
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String?
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  lastSeenAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([integrationId, externalId])
  @@index([ipAddress])
}

/// A device detected on the network via the firewall's ARP/neighbor table.
/// Catches everything the DHCP lease list misses: static-IP devices, other
/// routers/APs, and anything that talked through the firewall recently.
model NetworkNeighbor {
  id            String             @id @default(cuid())
  ipAddress     String
  macAddress    String?
  hostname      String?
  /// NIC vendor from the OUI database, e.g. "TP-Link Systems Inc".
  manufacturer  String?
  /// Firewall-side interface device the entry was learned on, e.g. "vlan0.1".
  interfaceKey  String?
  /// Permanent ARP entries are the firewall's own addresses.
  permanent     Boolean            @default(false)
  networkId     String?
  network       Network?           @relation(fields: [networkId], references: [id], onDelete: SetNull)
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String?
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  lastSeenAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([integrationId, externalId])
  @@index([ipAddress])
}

// ---------- edge / footprint ----------

/// A destination-NAT (port-forward) rule synced from the firewall — an inbound
/// attack-surface vector on the footprint map.
model PortForward {
  id              String             @id @default(cuid())
  integrationId   String?
  integration     IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId      String? // rule uuid
  sequence        Int?
  interfaceName   String?
  protocol        String?
  sourceSpec      String? // inbound source restriction, if any
  destSpec        String? // WAN-side destination ("wanip")
  destPort        String? // WAN-side port
  targetIp        String
  targetPort      String?
  descriptionText String?
  enabled         Boolean            @default(true)
  source          Source             @default(OPNSENSE)
  status          EntityStatus       @default(ACTIVE)
  missCount       Int                @default(0)
  lastSeenAt      DateTime?
  annotation      String?            @db.Text // PolySIEM-owned operator note; survives sync
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([integrationId, externalId])
}

/// A dynamic-DNS hostname synced from the firewall (one row per hostname).
model DyndnsHost {
  id            String             @id @default(cuid())
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String? // "<accountUuid>/<hostname>"
  hostname      String
  service       String?
  enabled       Boolean            @default(true)
  interfaceName String?
  currentIp     String?
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  lastSeenAt    DateTime?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([integrationId, externalId])
}

/// A routing gateway synced from the firewall (default WAN, backup, VPN hops).
model NetworkGateway {
  id            String             @id @default(cuid())
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String? // gateway uuid (or name)
  name          String
  interfaceName String?
  ipAddress     String?
  isDefault     Boolean            @default(false)
  online        Boolean?
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  lastSeenAt    DateTime?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([integrationId, externalId])
}

/// One reading of a cumulative firewall traffic counter — a pf rule's byte
/// counter (kind "rule", externalId = rule uuid, matching
/// FirewallRule.externalId; "system" aggregates unlabeled/auto rules) or an
/// interface's in/out byte counters (kind "interface", externalId = the
/// OPNsense interface key). `delta` is bytes since the previous sample and is
/// null on the first sample after a counter reset (rule counters reset on
/// every filter reload, interface counters on reboot). Raw samples are pruned
/// after 7 days by the poller.
model TrafficCounterSample {
  id            String            @id @default(cuid())
  integrationId String
  integration   IntegrationConfig @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  kind          String // "rule" | "interface"
  externalId    String // rule uuid / interface key
  sampledAt     DateTime          @default(now())
  bytes         BigInt // cumulative reading as-read
  bytesIn       BigInt? // interface kind only
  bytesOut      BigInt? // interface kind only
  delta         BigInt? // bytes since previous sample; null = baseline (first sample or reset)
  deltaSeconds  Int?

  @@index([integrationId, kind, externalId, sampledAt])
  @@index([integrationId, sampledAt])
}

/// A documented ingress tunnel (e.g. a cloudflared connector). Manual
/// documentation — never synced, and tunnel run tokens/secrets are never
/// stored (there is deliberately no column for them).
model Tunnel {
  id               String          @id @default(cuid())
  name             String
  provider         String          @default("cloudflare")
  tunnelExternalId String? // provider-side tunnel UUID (identifier only)
  originIp         String? // lab-side connector address
  ingressHostnames String[]        @default([])
  deviceId         String?
  device           Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  vmId             String?
  vm               VirtualMachine? @relation(fields: [vmId], references: [id], onDelete: SetNull)
  containerId      String?
  container        Container?      @relation(fields: [containerId], references: [id], onDelete: SetNull)
  notes            String?         @db.Text
  source           Source          @default(MANUAL)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  hostnames TunnelHostname[]

  @@index([name])
}

/// One ingress hostname of a Tunnel, with its last public-DNS resolution.
/// Rows are reconciled from Tunnel.ingressHostnames on create/update; the
/// resolved edge addresses tell us which CDN edge fronts the hostname (and
/// flag hostnames that resolve straight to the WAN — an exposure).
model TunnelHostname {
  id             String    @id @default(cuid())
  tunnelId       String
  tunnel         Tunnel    @relation(fields: [tunnelId], references: [id], onDelete: Cascade)
  hostname       String
  resolvedIps    String[]  @default([])
  proxied        Boolean? // true = all records inside the provider's edge ranges; null = unresolved
  lastResolvedAt DateTime?
  lastError      String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tunnelId, hostname])
  @@index([lastResolvedAt])
}

// ---------- ssh keys ----------

/// A documented SSH public key. Only the PUBLIC half is ever stored — there is
/// deliberately no column for private key material.
model SshKey {
  id          String   @id @default(cuid())
  name        String
  keyType     String // "ssh-ed25519" | "ssh-rsa" | "ecdsa-sha2-nistp256" | ...
  publicKey   String   @db.Text // full authorized_keys line, single line
  fingerprint String   @unique // "SHA256:<base64, no padding>" (ssh-keygen -lf format)
  bits        Int? // 256 for ed25519, modulus bits for RSA
  comment     String? // trailing comment from the key line
  purpose     String?  @db.Text // what the key is for / operator notes
  ownerLabel  String? // whose key it is
  source      Source   @default(MANUAL)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  deployments SshKeyDeployment[]

  @@index([name])
}

/// A machine+account where an SSH key is authorized. Typed FKs follow the
/// TagAssignment pattern; hostLabel covers machines not in the inventory.
model SshKeyDeployment {
  id         String  @id @default(cuid())
  sshKeyId   String
  sshKey     SshKey  @relation(fields: [sshKeyId], references: [id], onDelete: Cascade)
  username   String  @default("root") // account on the target machine
  method     String  @default("manual") // manual | proxmox-cloudinit | script
  notes      String?
  entityType String // device|vm|container|other

  deviceId    String?
  device      Device?         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vmId        String?
  vm          VirtualMachine? @relation(fields: [vmId], references: [id], onDelete: Cascade)
  containerId String?
  container   Container?      @relation(fields: [containerId], references: [id], onDelete: Cascade)
  hostLabel   String? // free-text host for entityType "other"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sshKeyId])
}

// ---------- documentation ----------

model DocPage {
  id         String    @id @default(cuid())
  title      String
  slug       String    @unique
  content    String    @db.Text
  parentId   String?
  parent     DocPage?  @relation("DocTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   DocPage[] @relation("DocTree")
  authorId   String?
  author     User?     @relation("DocAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdVia String    @default("ui") // "ui" | "mcp"
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tags TagAssignment[]

  @@index([title])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  color String @default("gray")

  assignments TagAssignment[]
}

model TagAssignment {
  id         String @id @default(cuid())
  tagId      String
  tag        Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  entityType String // device|vm|container|network|service|doc
  entityId   String

  // typed FKs so relation queries work; exactly one is set, enforced in the service layer
  deviceId    String?
  device      Device?         @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  vmId        String?
  vm          VirtualMachine? @relation(fields: [vmId], references: [id], onDelete: Cascade)
  containerId String?
  container   Container?      @relation(fields: [containerId], references: [id], onDelete: Cascade)
  networkId   String?
  network     Network?        @relation(fields: [networkId], references: [id], onDelete: Cascade)
  serviceId   String?
  service     Service?        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  docPageId   String?
  docPage     DocPage?        @relation(fields: [docPageId], references: [id], onDelete: Cascade)

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // "user" | "api_token" | "system"
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  apiTokenId String?
  action     String // "vm.update", "integration.sync", "user.create", ...
  entityType String?
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

// ---------- threat watch (AI log scanning) ----------

/// A security ticket in the SOAR-style response panel. Created by the AI log
/// scanner (createdBy "ai") or manually by a user. Re-scans that detect the
/// same underlying issue upsert on dedupeKey instead of duplicating.
model SecurityTicket {
  id                     String         @id @default(cuid())
  title                  String
  summary                String         @db.Text
  severity               TicketSeverity @default(MEDIUM)
  status                 TicketStatus   @default(OPEN)
  category               String         @default("anomaly") // anomaly|ids-alert|correlation|recon|auth|traffic|other
  createdBy              String         @default("ai") // "ai" | "user"
  dedupeKey              String?        @unique // stable hash of the underlying issue
  evidence               Json? // { samples: [...], scope, timeRange }
  suggestions            String?        @db.Text // AI-suggested response steps
  sourceRefs             Json? // { srcIps, destIps, signatures, hosts }
  /// Structured AI investigation report (InvestigationReport in agent/contract.ts).
  investigation          Json?
  /// When the agentic investigation last ran (completed).
  investigatedAt         DateTime?
  /// Background investigation lifecycle: null | "queued" | "running" | "success" | "failed".
  investigationStatus    String?
  /// When the current/last background investigation was enqueued/started.
  investigationStartedAt DateTime?
  /// Live progress while running (InvestigationProgress: tool calls + partial text), cleared on success.
  investigationProgress  Json?
  /// Failure message from the last background investigation, if it failed.
  investigationError     String?        @db.Text
  timesSeen              Int            @default(1)
  lastSeenAt             DateTime       @default(now())
  scanRunId              String?
  scanRun                AiScanRun?     @relation(fields: [scanRunId], references: [id], onDelete: SetNull)
  closedAt               DateTime?
  closedById             String?
  closedBy               User?          @relation("TicketCloser", fields: [closedById], references: [id], onDelete: SetNull)
  resolution             String?        @db.Text // note entered when closing
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([status, severity])
  @@index([createdAt])
}

/// A durable notebook page for investigating one suspicious IP address or
/// domain. Unlike a response ticket, it remains open-ended and editable while
/// its evidence snapshots are append-only.
model SecurityResearchPage {
  id               String                 @id @default(cuid())
  title            String
  subject          String
  subjectType      String // "ip" | "domain"
  parentId         String?
  parent           SecurityResearchPage?  @relation("ResearchTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         SecurityResearchPage[] @relation("ResearchTree")
  status           String                 @default("open") // "open" | "archived"
  verdict          String                 @default("unknown") // unknown|benign|suspicious|malicious
  notes            String?                @db.Text
  createdById      String?
  createdBy        User?                  @relation("ResearchPageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastResearchedAt DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  evidence SecurityResearchEvidence[]

  @@index([status, updatedAt])
  @@index([subject])
  @@index([createdById])
  @@index([parentId])
}

/// An immutable provider result captured during a research run. `runId`
/// groups DNS, logs, inventory, Censys and SecurityTrails results captured at
/// the same point in time without overwriting prior evidence.
model SecurityResearchEvidence {
  id         String               @id @default(cuid())
  pageId     String
  page       SecurityResearchPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  runId      String
  provider   String
  kind       String
  status     String               @default("success")
  title      String
  summary    String?              @db.Text
  query      String?
  sourceUrl  String?
  data       Json
  capturedAt DateTime             @default(now())

  @@index([pageId, capturedAt])
  @@index([runId])
  @@index([provider, capturedAt])
}

/// One execution of the AI log scanner (manual or interval-triggered).
model AiScanRun {
  id            String     @id @default(cuid())
  status        SyncStatus @default(RUNNING)
  trigger       String // "manual" | "interval"
  model         String
  startedAt     DateTime   @default(now())
  finishedAt    DateTime?
  timeRangeFrom DateTime
  timeRangeTo   DateTime
  stats         Json? // { docsScanned, suricataAlerts, ticketsCreated, ticketsUpdated, scopesRun }
  error         String?    @db.Text

  tickets SecurityTicket[]

  @@index([startedAt])
}

// ---------- vector embeddings (RAG) ----------

/// A chunk of source text plus its embedding vector, for RAG similarity search.
/// Vectors are stored as a plain double-precision array (Float[]); similarity is
/// computed in-app (cosine) — homelab-scale corpora make a dedicated vector
/// index unnecessary. Rows are (re)generated when their source changes.
model EmbeddingChunk {
  id         String   @id @default(cuid())
  /// What the chunk came from: "doc" | "device" | "vm" | "container" | "network" | "service".
  sourceType String
  /// Id of the source row (DocPage.id, Device.id, …).
  sourceId   String
  /// 0-based index of this chunk within its source.
  chunkIndex Int      @default(0)
  /// Display title of the source (doc title / entity name).
  title      String
  /// The chunk text that was embedded.
  content    String   @db.Text
  /// The embedding vector.
  embedding  Float[]
  /// Embedding model that produced the vector (invalidate on change).
  model      String
  /// In-app link to the source, for search results.
  href       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([sourceType, sourceId, chunkIndex])
  @@index([sourceType, sourceId])
}

// ---------- wireless (UniFi) ----------

/// A wireless network (SSID) synced from a UniFi controller.
model WirelessNetwork {
  id            String             @id @default(cuid())
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String? // UniFi wlanconf _id
  source        Source             @default(UNIFI)
  name          String // SSID
  enabled       Boolean            @default(true)
  security      String? // open | wpapsk | wpaeap
  wpaMode       String? // wpa2 | wpa3 | wpa3-transition
  band          String? // both | 2g | 5g | 6e
  hidden        Boolean            @default(false)
  isGuest       Boolean            @default(false)
  vlanId        Int?
  networkId     String?
  network       Network?           @relation(fields: [networkId], references: [id], onDelete: SetNull)
  apCount       Int? // broadcasting AP count
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  lastSeenAt    DateTime?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([integrationId, externalId])
  @@index([name])
}

/// A wireless access point synced from a UniFi controller.
model WirelessAp {
  id            String             @id @default(cuid())
  integrationId String?
  integration   IntegrationConfig? @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  externalId    String? // UniFi device _id or MAC
  source        Source             @default(UNIFI)
  name          String
  model         String?
  mac           String?
  ipAddress     String?
  adopted       Boolean            @default(false)
  state         String? // online | offline | pending
  deviceId      String?
  device        Device?            @relation("ApDevice", fields: [deviceId], references: [id], onDelete: SetNull)
  status        EntityStatus       @default(ACTIVE)
  missCount     Int                @default(0)
  lastSeenAt    DateTime?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([integrationId, externalId])
}

/// Incremental cache of OTX threat-intel pulses, keyed per feed source
/// (integration id or "personal:<userId>"). Backfilled once, then kept fresh
/// with modified_since delta fetches — the same pulse is never re-downloaded.
model OtxPulseCache {
  sourceKey String
  pulseId   String
  modified  DateTime
  created   DateTime
  /// { view: PulseView, ips: string[], domains: string[] } — precomputed IOCs.
  data      Json
  fetchedAt DateTime @default(now())

  @@id([sourceKey, pulseId])
  @@index([sourceKey, modified(sort: Desc)])
}

/// Per-user read receipts for OTX reports. These intentionally do not point at
/// OtxPulseCache: demo feeds are not cached, and receipts should survive a
/// cache refresh or eviction.
model OtxPulseRead {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceKey String
  pulseId   String
  readAt    DateTime @default(now())

  @@id([userId, sourceKey, pulseId])
  @@index([sourceKey, pulseId])
}

// ---------- workflows (automation rules engine) ----------

enum WorkflowRunStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

enum WorkflowStepStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

/// A user-built automation workflow: a DAG of trigger/action/condition nodes
/// stored as a WorkflowGraph JSON blob (see src/lib/workflows/types.ts).
model Workflow {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  enabled     Boolean  @default(true)
  graph       Json
  createdById String?
  createdBy   User?    @relation("WorkflowCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs WorkflowRun[]

  @@index([name])
}

/// One execution of a workflow. Step outputs are persisted with secret output
/// keys redacted; secret values only exist in the one-time run response.
model WorkflowRun {
  id         String            @id @default(cuid())
  workflowId String
  workflow   Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     WorkflowRunStatus @default(RUNNING)
  trigger    String            @default("manual")
  input      Json
  error      String?           @db.Text
  startedAt  DateTime          @default(now())
  finishedAt DateTime?

  steps WorkflowRunStep[]
  logs  WorkflowRunLog[]

  @@index([workflowId, startedAt])
}

/// Console output of a run: one row per line, ordered by `seq` within the run.
/// Tailed live while the run is going (poll for seq > cursor) and kept for
/// historic runs. `nodeId` is null for run-level lines.
model WorkflowRunLog {
  id        String           @id @default(cuid())
  runId     String
  run       WorkflowRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId    String?
  level     WorkflowLogLevel @default(INFO)
  message   String           @db.Text
  seq       Int
  createdAt DateTime         @default(now())

  @@unique([runId, seq])
  @@index([runId, seq])
}

enum WorkflowLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

/// One node execution within a workflow run, in topological order.
model WorkflowRunStep {
  id         String             @id @default(cuid())
  runId      String
  run        WorkflowRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeId     String
  kind       String
  label      String
  status     WorkflowStepStatus @default(PENDING)
  startedAt  DateTime?
  finishedAt DateTime?
  output     Json?
  error      String?            @db.Text
  sortOrder  Int                @default(0)

  @@index([runId])
}

/// A credential the admin explicitly allows AI assistants to read through the
/// MCP server (gated behind the "credentials" token scope). Secret encrypted
/// with APP_SECRET; never returned by the REST API, only by the MCP tool.
model AiCredential {
  id              String   @id @default(cuid())
  name            String   @unique
  description     String?  @db.Text
  username        String?
  encryptedSecret String
  url             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
