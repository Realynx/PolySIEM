# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next*/
/out/
/.turbo/

# Next.js / Turbopack crash diagnostics
/next-panic-*.log
/turbopack-*.log
/core
/core.*
*.dmp
*.dump
*.crash

# production
/build

# local runtime data (generated web certificates, etc.)
/data/

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local development-agent scratch files
/.codex-tmp/
/.codex-dev*.log
/.codex-realpath-preload.cjs

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# rust (native/privacy-proxy). Cargo.lock IS committed: this is a binary crate and
# the Docker build uses `--locked` so the shipped proxy is reproducible.
/native/*/target/

# Locally built privacy-proxy binary (the Docker image builds its own)
/assets/

# Locally assembled release bundles (scripts/build-linux-bundle.sh)
/dist/
